FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ && \
    rm -rf /var/lib/apt/lists/*

COPY requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY src/ src/
COPY data/commodities_clean_data.parquet data/
COPY data/features_describe.csv data/
COPY scripts/ scripts/

# Make src importable without installing full pyproject.toml deps
ENV PYTHONPATH=/app

# Train model at build time
RUN mkdir -p models && python scripts/train_model.py

EXPOSE 8000

# Render injects $PORT at runtime; default to 8000 for local dev
CMD uvicorn src.serving.app:app --host 0.0.0.0 --port ${PORT:-8000}
