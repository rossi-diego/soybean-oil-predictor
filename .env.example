# Soybean Oil Predictor — Environment Variables
# Copy this file to .env and fill in the values.

# --- API Configuration ---
API_HOST=0.0.0.0
API_PORT=8000
API_LOG_LEVEL=info

# --- Data Sources ---
# USDA WASDE API key (free at https://quickstats.nass.usda.gov/api)
USDA_API_KEY=your_usda_api_key_here

# FRED API key (free at https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=your_fred_api_key_here

# --- Database ---
DUCKDB_PATH=data/soybean_oil.duckdb

# --- MLflow ---
MLFLOW_TRACKING_URI=./mlruns
MLFLOW_EXPERIMENT_NAME=soybean-oil-predictor

# --- Monitoring ---
EVIDENTLY_REPORT_PATH=reports/monitoring

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
